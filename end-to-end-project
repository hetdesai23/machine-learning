# Import libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import pickle

# Import machine learning tools
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score

# Import decision region plotting function
from mlxtend.plotting import plot_decision_regions


# 1. Load the dataset
df = pd.read_csv('placement.csv')

# Remove the first column (usually an ID or serial number)
df = df.iloc[:, 1:]

# Display the first 5 rows
print(df.head())

# Display dataset information
df.info()

# Display the number of rows and columns
print("Dataset shape:", df.shape)


# 2. Visualize the dataset
plt.figure(figsize=(8, 5))

plt.scatter(
    df['cgpa'],
    df['iq'],
    c=df['placement'],
    cmap='viridis'
)

# Add labels and title
plt.xlabel('CGPA')
plt.ylabel('IQ')
plt.title('CGPA vs IQ (Placement Status)')
plt.colorbar(label='Placement Status')
plt.show()


# 3. Separate input features and target variable
# X contains CGPA and IQ
x = df[['cgpa', 'iq']]

# y contains the placement status
y = df['placement']


# 4. Split the dataset into training and testing sets
# 90% training data and 10% testing data
# random_state=42 ensures the same split every time
x_train, x_test, y_train, y_test = train_test_split(
    x,
    y,
    test_size=0.1,
    random_state=42
)


# 5. Standardize the input features
sc = StandardScaler()

# Fit the scaler on training data and transform it
x_train_scaled = sc.fit_transform(x_train)

# Use the same scaler to transform testing data
x_test_scaled = sc.transform(x_test)


# 6. Create and train the Logistic Regression model
clf = LogisticRegression()

# Train the model using the scaled training data
clf.fit(x_train_scaled, y_train)


# 7. Make predictions on the testing data
y_pred = clf.predict(x_test_scaled)


# 8. Evaluate the model
accuracy = accuracy_score(y_test, y_pred)

print("Model Accuracy:", accuracy)
print("Model Accuracy (%):", round(accuracy * 100, 2), "%")


# 9. Visualize the decision regions
plt.figure(figsize=(8, 5))

plot_decision_regions(
    x_train_scaled,
    y_train.to_numpy(),
    clf=clf,
    legend=2
)

plt.xlabel('CGPA (Standardized)')
plt.ylabel('IQ (Standardized)')
plt.title('Logistic Regression Decision Regions')
plt.show()


# 10. Save the trained model
with open('model.pkl', 'wb') as file:
    pickle.dump(clf, file)

# Save the scaler used during training
with open('scaler.pkl', 'wb') as file:
    pickle.dump(sc, file)

print("Model saved as model.pkl")
print("Scaler saved as scaler.pkl")
